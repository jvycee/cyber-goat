{{!-- Footer partial for the cyberpunk Ghost theme --}}

<footer class="site-footer glass footer-{{@custom.footer_style}}" role="contentinfo">
    <div class="footer-container">
        {{!-- Footer Main Content --}}
        <div class="footer-main">
            {{!-- Site Info --}}
            <div class="footer-section footer-about">
                <div class="footer-logo">
                    {{#if @site.logo}}
                    <img src="{{img_url @site.logo size="s"}}" alt="{{@site.title}}" class="footer-logo-img">
                    {{else}}
                    <span class="footer-site-title text-glow">{{@site.title}}</span>
                    {{/if}}
                </div>
                
                {{#if @site.description}}
                <p class="footer-description">{{@site.description}}</p>
                {{/if}}
                
                <div class="footer-stats">
                    <div class="footer-stat">
                        <span class="stat-number">{{@site.posts_count}}</span>
                        <span class="stat-label">Posts</span>
                    </div>
                    <div class="footer-stat">
                        <span class="stat-number">{{@site.members_count}}</span>
                        <span class="stat-label">Members</span>
                    </div>
                </div>
            </div>
            
            {{!-- Social Links --}}
            <div class="footer-section footer-social">
                <h4 class="footer-section-title">Connect</h4>
                <div class="social-links-compact">
                    {{!-- Threads --}}
                    {{#if @custom.threads_url}}
                    <a href="{{@custom.threads_url}}" 
                       class="social-link-icon" 
                       target="_blank" 
                       rel="noopener"
                       aria-label="Threads"
                       title="Follow on Threads">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 013.02.142c-.126-1.455-.499-2.501-1.109-3.11-.642-.64-1.6-.974-2.849-.990h-.058c-.427 0-.823.034-1.178.101l-.106-2.03a8.939 8.939 0 011.342-.104c1.658.02 3.03.472 4.07 1.344.851.712 1.41 1.656 1.662 2.805.16.068.314.142.463.222.987.532 1.752 1.297 2.21 2.21.725 1.443.914 3.651-.898 5.833-1.052 1.265-2.51 2.061-4.125 2.445a14.105 14.105 0 01-2.518.225zm.287-11.358c-.965.051-1.691.323-2.154.807-.42.436-.619.967-.577 1.534.044.574.35 1.075.886 1.45.52.366 1.238.531 2.012.474.928-.068 1.628-.37 2.138-.925.487-.527.786-1.308.891-2.318a11.575 11.575 0 00-3.196-.022z"/>
                        </svg>
                    </a>
                    {{/if}}
                    
                    {{!-- Bluesky --}}
                    {{#if @custom.bluesky_url}}
                    <a href="{{@custom.bluesky_url}}" 
                       class="social-link-icon" 
                       target="_blank" 
                       rel="noopener"
                       aria-label="Bluesky"
                       title="Follow on Bluesky">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.815 2.736 3.713 3.66 6.383 3.364.136-.02.275-.039.415-.056-.138.022-.276.04-.415.056-3.912.58-7.387 2.005-2.83 7.078 5.013 5.19 6.87-1.113 7.823-4.308.953 3.195 2.05 9.271 7.733 4.308 4.267-4.308 1.172-6.498-2.74-7.078a8.741 8.741 0 01-.415-.056c.14.017.279.036.415.056 2.67.297 5.568-.628 6.383-3.364.246-.828.624-5.79.624-6.478 0-.69-.139-1.861-.902-2.206-.659-.298-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8Z"/>
                        </svg>
                    </a>
                    {{/if}}
                    
                    {{!-- Medium --}}
                    {{#if @custom.medium_url}}
                    <a href="{{@custom.medium_url}}" 
                       class="social-link-icon" 
                       target="_blank" 
                       rel="noopener"
                       aria-label="Medium"
                       title="Read on Medium">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42M24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/>
                        </svg>
                    </a>
                    {{/if}}
                    
                    {{!-- GitHub --}}
                    {{#if @custom.github_url}}
                    <a href="{{@custom.github_url}}" 
                       class="social-link-icon" 
                       target="_blank" 
                       rel="noopener"
                       aria-label="GitHub"
                       title="Code on GitHub">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>
                        </svg>
                    </a>
                    {{/if}}
                    
                    {{!-- RSS Feed (always show) --}}
                    <a href="{{@site.url}}/rss/" 
                       class="social-link-icon" 
                       target="_blank" 
                       rel="noopener"
                       aria-label="RSS Feed"
                       title="RSS Feed">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M3.429 5.1v2.4c7.248 0 13.114 5.886 13.114 13.142h2.4C18.943 12.18 11.886 5.1 3.429 5.1zm0 4.8v2.4a5.351 5.351 0 015.371 5.371h2.4c0-4.302-3.49-7.771-7.771-7.771zM6.171 15.486a1.714 1.714 0 100 3.428 1.714 1.714 0 000-3.428z"/>
                        </svg>
                    </a>
                </div>
            </div>
            
            {{!-- Newsletter Signup (if enabled) --}}
            {{#if @site.members_enabled}}
            {{#unless @member}}
            <div class="footer-section footer-newsletter">
                <h4 class="footer-section-title">Stay Updated</h4>
                
                <form class="footer-newsletter-form" data-members-form="subscribe">
                    <div class="newsletter-input-group">
                        <input 
                            type="email" 
                            class="newsletter-input input" 
                            placeholder="Your email"
                            data-members-email
                            required
                            aria-label="Email address"
                        >
                        <button type="submit" class="newsletter-btn btn btn-primary btn-sm">
                            <span class="btn-text">Subscribe</span>
                        </button>
                    </div>
                    <div class="newsletter-feedback">
                        <p class="newsletter-success" data-members-success>
                            Thanks! Check your email.
                        </p>
                        <p class="newsletter-error" data-members-error>
                            Error. Please try again.
                        </p>
                    </div>
                </form>
            </div>
            {{/unless}}
            {{/if}}
        </div>
        
        {{!-- Footer Bottom --}}
        <div class="footer-bottom">
            <div class="footer-copyright">
                <p class="copyright-text">
                    © {{date format="YYYY"}} {{@site.title}}. 
                    Powered by <a href="https://ghost.org" target="_blank" rel="noopener" class="ghost-link">Ghost</a>
                    {{#if @custom.show_theme_credit}}
                    & <span class="theme-credit">Cyberpunk Theme</span>
                    {{/if}}
                </p>
            </div>
            
            <div class="footer-actions">
                {{!-- Back to Top --}}
                <button class="back-to-top btn btn-ghost btn-sm" id="backToTop" aria-label="Back to top">
                    <span class="btn-icon">↑</span>
                    <span class="btn-text">Top</span>
                </button>
                
                {{!-- Theme Toggle (small version) --}}
                <button class="footer-theme-toggle btn btn-ghost btn-sm" 
                        onclick="document.getElementById('themeToggle').click()" 
                        aria-label="Change theme">
                    <span class="btn-icon">🎨</span>
                </button>
            </div>
        </div>
    </div>
    
    {{!-- Footer Decorations --}}
    <div class="footer-decorations">
        <div class="footer-neon-line"></div>
        <div class="footer-grid-pattern"></div>
    </div>
</footer>